<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Jellyfin.Plugin.CollectionStudio</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.CollectionStudio</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8604;CS8618;CS8625;CS0618</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0'">
    <JfControllerVersion>10.9.11</JfControllerVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0'">
    <JfControllerVersion>10.11.11</JfControllerVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0'">
    <JfControllerVersion>12.4.0</JfControllerVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JfControllerVersion)" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web/**/*" />
  </ItemGroup>

  <Target Name="CollectionStudioInlinePage" BeforeTargets="BeforeBuild" Condition="Exists('web/index.html')">
    <Exec Command="&quot;I:\Program Files\nodejs\node.exe&quot; &quot;$(MSBuildProjectDirectory)\tools\inline.mjs&quot;" ContinueOnError="false" />
  </Target>
</Project>
